rules_version = '2';
// Gather security rules — paste into Firebase console > Firestore Database > Rules, then Publish.
// Every church/group lives under /churches/{id} and is invisible to every other group.
// Message text, file contents, group names and announcements are encrypted on the phone,
// so even the Firebase project owner only ever sees scrambled data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function memPath(cid) { return /databases/$(database)/documents/churches/$(cid)/members/$(request.auth.uid); }
    function isMember(cid) { return signedIn() && exists(memPath(cid)) && get(memPath(cid)).data.role in ['member', 'leader']; }
    function isLeader(cid) { return signedIn() && exists(memPath(cid)) && get(memPath(cid)).data.role == 'leader'; }
    function leaderAfter(cid) { return signedIn() && getAfter(memPath(cid)).data.role == 'leader'; }

    // Personal account: list of my groups. Only me.
    match /users/{u} {
      allow read, create, update: if signedIn() && uid() == u;
      allow delete: if false;
    }

    // Invite codes: anyone holding the exact code can see the group's public look. No listing.
    match /invites/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if code.size() >= 8
        && request.resource.data.keys().hasOnly(['churchId', 'name', 'tagline', 'accent', 'logo', 'welcome'])
        && str(request.resource.data.name, 1, 40)
        && request.resource.data.logo is string && request.resource.data.logo.size() < 120000
        && leaderAfter(request.resource.data.churchId);
      allow delete: if isLeader(resource.data.churchId);
    }

    match /churches/{cid} {
      allow get: if isMember(cid);
      allow list: if false;                                   // no one can browse other groups
      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && str(request.resource.data.name, 1, 40)
        && leaderAfter(cid);
      allow update: if isLeader(cid) && changed().hasOnly(['name', 'theme', 'invite'])
        && (!('theme' in request.resource.data) || request.resource.data.theme.logo.size() < 120000);
      allow delete: if isLeader(cid);                         // leaders can delete the whole group

      // Small Group: events with RSVP, and prayer requests — for approved members of this group only.
      // Titles, details and prayers are end-to-end encrypted (iv/ct); the server only sees who posted,
      // the event time, RSVP answers, privacy and status.
      match /events/{eid} {
        allow read: if isMember(cid);
        allow create: if isLeader(cid)
          && request.resource.data.keys().hasOnly(['uid', 'startAt', 'iv', 'ct', 'rsvp', 'createdAt', 'updatedAt'])
          && request.resource.data.uid == uid()
          && request.resource.data.startAt is timestamp
          && request.resource.data.iv is string && str(request.resource.data.ct, 1, 20000)
          && request.resource.data.rsvp == {}
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if
          // leaders edit the event
          (isLeader(cid) && changed().hasOnly(['startAt', 'iv', 'ct', 'updatedAt'])
            && request.resource.data.startAt is timestamp && str(request.resource.data.ct, 1, 20000)
            && request.resource.data.updatedAt == request.time)
          // anyone in the group answers for themselves only: Going / Maybe / Can't go (or clears it)
          || (isMember(cid) && changed().hasOnly(['rsvp'])
            && request.resource.data.rsvp.diff(resource.data.rsvp).affectedKeys().hasOnly([uid()])
            && (!(uid() in request.resource.data.rsvp) || request.resource.data.rsvp[uid()] in ['going', 'maybe', 'no']));
        allow delete: if isLeader(cid);
      }

      // Anonymous posts: the post itself carries no author (uid is null), so other members — leaders
      // included — can't tell who wrote it. A private "owner" record, readable only by its author, lets
      // the author manage the post. Every post/comment id is random, and an owner record can only be
      // created together with the brand-new post it belongs to.
      function ownerPath(id) { return /databases/$(database)/documents/churches/$(cid)/owners/$(id); }
      function ownsNow(id) { return exists(ownerPath(id)) && get(ownerPath(id)).data.uid == uid(); }
      function ownsAfter(id) { return getAfter(ownerPath(id)).data.uid == uid(); }
      // a new post is either signed (uid = me, anon = false) or anonymous (uid = null + my owner record)
      function authorship(id) {
        return (request.resource.data.anon == false && request.resource.data.uid == uid())
          || (request.resource.data.anon == true && request.resource.data.uid == null && ownsAfter(id));
      }
      function isAuthor(id) { return resource.data.uid == uid() || (resource.data.get('anon', false) == true && ownsNow(id)); }
      match /owners/{id} {
        allow get, list: if signedIn() && resource.data.uid == uid();
        allow create: if isMember(cid) && request.resource.data.keys().hasOnly(['uid', 'kind']) && request.resource.data.uid == uid()
          && (!('kind' in request.resource.data) || request.resource.data.kind in ['prayer', 'devotion', 'comment'])
          && !exists(/databases/$(database)/documents/churches/$(cid)/prayers/$(id))
          && !exists(/databases/$(database)/documents/churches/$(cid)/devotions/$(id))
          && !exists(/databases/$(database)/documents/churches/$(cid)/devComments/$(id))
          && (existsAfter(/databases/$(database)/documents/churches/$(cid)/prayers/$(id))
            || existsAfter(/databases/$(database)/documents/churches/$(cid)/devotions/$(id))
            || existsAfter(/databases/$(database)/documents/churches/$(cid)/devComments/$(id)));
        allow delete: if signedIn() && resource.data.uid == uid();
      }

      // Prayer requests — anyone in the group can post, signed or anonymously.
      // "Leaders Only" requests are returned only to their author and the group's leaders.
      function canSeePrayer(p, id) { return isMember(cid) && (p.privacy == 'group' || isLeader(cid) || p.uid == uid() || (p.get('anon', false) == true && ownsNow(id))); }
      match /prayers/{pid} {
        function prayerPath() { return /databases/$(database)/documents/churches/$(cid)/prayers/$(pid); }
        function responsePath() { return /databases/$(database)/documents/churches/$(cid)/prayers/$(pid)/responses/$(request.auth.uid); }
        function authorOrLeader() { return isMember(cid) && (isLeader(cid) || isAuthor(pid)); }
        allow read: if canSeePrayer(resource.data, pid);
        allow create: if isMember(cid)
          && request.resource.data.keys().hasOnly(['uid', 'anon', 'privacy', 'status', 'prayedCount', 'iv', 'ct', 'createdAt', 'answeredAt'])
          && authorship(pid)
          && request.resource.data.privacy in ['group', 'leaders']
          && request.resource.data.status == 'active' && request.resource.data.prayedCount == 0
          && request.resource.data.iv is string && str(request.resource.data.ct, 1, 20000)
          && request.resource.data.createdAt == request.time && request.resource.data.answeredAt == null;
        allow update: if canSeePrayer(resource.data, pid) && (
            // "I Prayed": +1 exactly once per person, together with that person's response record
            (changed().hasOnly(['prayedCount'])
              && request.resource.data.prayedCount == resource.data.prayedCount + 1
              && !exists(responsePath()) && existsAfter(responsePath()))
            // the author or a leader marks it answered (the encrypted text can carry a testimony)
            || (authorOrLeader() && resource.data.status == 'active'
              && changed().hasOnly(['status', 'answeredAt', 'iv', 'ct'])
              && request.resource.data.status == 'answered' && request.resource.data.answeredAt == request.time
              && str(request.resource.data.ct, 1, 20000))
            // ...and can update the testimony afterwards
            || (authorOrLeader() && resource.data.status == 'answered'
              && changed().hasOnly(['iv', 'ct']) && str(request.resource.data.ct, 1, 20000))
          );
        allow delete: if authorOrLeader();
        // one record per person (document id = their uid): "I Prayed" can't be counted twice; who prayed stays private
        match /responses/{u} {
          allow get: if signedIn() && u == uid();
          allow list: if isLeader(cid);                      // only used when a leader deletes the whole group
          allow create: if signedIn() && u == uid()
            && canSeePrayer(get(prayerPath()).data, pid)
            && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time
            && getAfter(prayerPath()).data.prayedCount == get(prayerPath()).data.prayedCount + 1;
          allow update: if false;
          allow delete: if isLeader(cid);
        }
      }

      // Today's devotion — anyone in the group can share one (signed or anonymous); everyone in the group
      // can like it once and comment.
      match /devotions/{did} {
        function devPath() { return /databases/$(database)/documents/churches/$(cid)/devotions/$(did); }
        function likePath() { return /databases/$(database)/documents/churches/$(cid)/devotions/$(did)/likes/$(request.auth.uid); }
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.keys().hasOnly(['uid', 'anon', 'iv', 'ct', 'likeCount', 'createdAt'])
          && authorship(did)
          && request.resource.data.iv is string && str(request.resource.data.ct, 1, 30000)
          && request.resource.data.likeCount == 0 && request.resource.data.createdAt == request.time;
        allow update: if isMember(cid) && (
            // like: +1 with my like record; unlike: -1 removing it
            (changed().hasOnly(['likeCount']) && request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(likePath()) && existsAfter(likePath()))
            || (changed().hasOnly(['likeCount']) && request.resource.data.likeCount == resource.data.likeCount - 1
              && exists(likePath()) && !existsAfter(likePath()))
            // the author edits the text
            || (isAuthor(did) && changed().hasOnly(['iv', 'ct']) && str(request.resource.data.ct, 1, 30000))
          );
        allow delete: if isMember(cid) && (isLeader(cid) || isAuthor(did));
        match /likes/{u} {
          allow get: if signedIn() && u == uid();
          allow list: if isLeader(cid);
          allow create: if isMember(cid) && u == uid()
            && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time
            && getAfter(devPath()).data.likeCount == get(devPath()).data.likeCount + 1;
          allow delete: if (signedIn() && u == uid() && isMember(cid)
              && existsAfter(devPath()) && getAfter(devPath()).data.likeCount == get(devPath()).data.likeCount - 1)
            || isLeader(cid);
        }
      }
      match /devComments/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.keys().hasOnly(['did', 'uid', 'anon', 'iv', 'ct', 'createdAt'])
          && exists(/databases/$(database)/documents/churches/$(cid)/devotions/$(request.resource.data.did))
          && authorship(id)
          && request.resource.data.iv is string && str(request.resource.data.ct, 1, 5000)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isMember(cid) && (isLeader(cid) || isAuthor(id));
      }

      match /members/{u} {
        allow get: if signedIn() && (uid() == u || isLeader(cid) || (isMember(cid) && resource.data.role in ['member', 'leader']));
        allow list: if isLeader(cid) || (isMember(cid) && resource.data.role in ['member', 'leader']);
        allow create: if signedIn() && uid() == u
          && request.resource.data.keys().hasOnly(['name', 'photo', 'role', 'devs', 'ck', 'invite', 'joinedAt'])
          && str(request.resource.data.name, 1, 30)
          && request.resource.data.devs is map && request.resource.data.devs.size() >= 1 && request.resource.data.devs.size() <= 10
          && request.resource.data.joinedAt == request.time
          && (
            // joining with a valid invite code → always starts as "pending"
            (request.resource.data.role == 'pending'
              && !('ck' in request.resource.data)
              && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
              && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.churchId == cid)
            // the person creating a brand-new group becomes its first leader
            || (request.resource.data.role == 'leader'
              && !exists(/databases/$(database)/documents/churches/$(cid))
              && getAfter(/databases/$(database)/documents/churches/$(cid)).data.createdBy == uid())
          );
        allow update: if
          // me: my display name, photo and my devices' public keys (a new phone registers itself)
          (signedIn() && uid() == u && resource.data.role != 'removed'
            && changed().hasOnly(['name', 'photo', 'devs'])
            && str(request.resource.data.name, 1, 30)
            && request.resource.data.devs is map && request.resource.data.devs.size() <= 10)
          // any approved member can hand the group key to another member's new device
          || (isMember(cid) && changed().hasOnly(['ck']) && request.resource.data.ck is map)
          // leaders: approve / remove / make leader, and hand out the group key
          || (isLeader(cid) && changed().hasOnly(['role', 'ck'])
            && request.resource.data.role in ['pending', 'member', 'leader', 'removed']);
        // leave the group yourself; leaders remove everyone when deleting the group
        allow delete: if signedIn() && (uid() == u || isLeader(cid));
      }

      // Email addresses: only the person themself and leaders (to recognise who's asking to join)
      match /contacts/{u} {
        allow read: if signedIn() && (uid() == u || isLeader(cid));
        allow create, update: if signedIn() && uid() == u
          && request.resource.data.keys().hasOnly(['email'])
          && request.resource.data.email == request.auth.token.email;
        allow delete: if signedIn() && (uid() == u || isLeader(cid));
      }

      match /announcements/{id} {
        allow read: if isMember(cid);
        allow create: if isLeader(cid)
          && request.resource.data.keys().hasOnly(['uid', 'pinned', 'iv', 'ct', 'createdAt'])
          && request.resource.data.uid == uid()
          && request.resource.data.pinned is bool
          && str(request.resource.data.ct, 1, 20000)
          && request.resource.data.createdAt == request.time;
        allow delete: if isLeader(cid);
      }

      // Reports go to leaders only, encrypted to each leader's key
      match /reports/{id} {
        allow read, delete: if isLeader(cid);
        allow create: if isMember(cid)
          && request.resource.data.keys().hasOnly(['reporter', 'wk', 'iv', 'ct', 'createdAt'])
          && request.resource.data.reporter == uid()
          && request.resource.data.wk is map && request.resource.data.wk.size() <= 50
          && str(request.resource.data.ct, 1, 400000)
          && request.resource.data.createdAt == request.time;
      }

      // Notification addresses (where to send "new message" pings). Members of this group only; only you can change yours.
      match /push/{u} {
        allow read: if isMember(cid);
        allow create, update: if isMember(cid) && uid() == u
          && request.resource.data.keys().hasOnly(['subs'])
          && request.resource.data.subs is map && request.resource.data.subs.size() <= 10;
        allow delete: if signedIn() && (uid() == u || isLeader(cid));
      }

      match /rooms/{rid} {
        function room() { return get(/databases/$(database)/documents/churches/$(cid)/rooms/$(rid)).data; }
        function inRoom() { return isMember(cid) && (room().type == 'main' || uid() in room().members); }
        // who can manage a chat: the group's creator (or anyone in it once the creator has left); either person in a private chat
        function admin(r) { return uid() in r.members
          && ((r.type == 'group' && (r.createdBy == uid() || !(r.createdBy in r.members))) || r.type == 'dm'); }
        function keysOk() { return request.resource.data.wk.keys().toSet().difference(request.resource.data.members.toSet()).size() == 0; }

        // a chat is visible only to its members (main chat: everyone approved). Leaders get nothing extra.
        allow read: if isMember(cid) && (resource == null || resource.data.type == 'main' || uid() in resource.data.members);

        allow create: if
          (rid == 'main' && request.resource.data.type == 'main' && leaderAfter(cid))
          || (isMember(cid)
            && request.resource.data.createdBy == uid()
            && request.resource.data.members is list
            && uid() in request.resource.data.members
            && request.resource.data.members.size() >= 2
            && request.resource.data.members.size() <= 100
            && request.resource.data.wk is map && keysOk()
            && ((request.resource.data.type == 'dm'
                  && request.resource.data.members.size() == 2
                  && rid == 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1])
                || request.resource.data.type == 'group'));

        allow update: if isMember(cid) && (resource.data.type == 'main' || uid() in resource.data.members) && (
            // "last message" preview (encrypted)
            (changed().hasOnly(['lastAt', 'lastUid', 'lastEnc']) && request.resource.data.lastUid == uid())
            // "I've read up to now" (only your own entry, stamped by the server)
            || (changed().hasOnly(['reads'])
                && request.resource.data.reads.diff(resource.data.get('reads', {})).affectedKeys().hasOnly([uid()])
                && request.resource.data.reads[uid()] == request.time)
            // any member can share the chat key with another member who's missing it
            || (resource.data.type != 'main' && changed().hasOnly(['wk']) && keysOk())
            // anyone in a group chat can rename it
            || (resource.data.type == 'group' && changed().hasOnly(['nameEnc']))
            // the chat's manager: add or remove people
            || (resource.data.type == 'group' && admin(resource.data)
                && changed().hasOnly(['nameEnc', 'members', 'wk'])
                && request.resource.data.members.size() <= 100 && keysOk())
            // anyone can leave a group
            || (resource.data.type == 'group' && changed().hasOnly(['members', 'wk'])
                && request.resource.data.members.toSet() == resource.data.members.toSet().difference([uid()].toSet())
                && keysOk())
          );

        allow delete: if isMember(cid) && ((resource.data.type != 'main' && admin(resource.data)) || (rid == 'main' && isLeader(cid)));

        match /messages/{id} {
          allow read: if inRoom();
          allow create: if inRoom()
            && request.resource.data.keys().hasOnly(['uid', 'iv', 'ct', 'createdAt'])
            && request.resource.data.uid == uid()
            && str(request.resource.data.ct, 1, 20000)
            && request.resource.data.createdAt == request.time;
          // your own messages; leaders in the main chat; the chat's manager (when deleting the chat)
          allow delete: if isMember(cid) && (resource.data.uid == uid()
            || (rid == 'main' && isLeader(cid))
            || (room().type != 'main' && admin(room())));
        }

        // Photos and files: encrypted on the phone, stored as ~600 KB pieces (keeps the free plan)
        match /files/{fid} {
          function fileOwner() { return get(/databases/$(database)/documents/churches/$(cid)/rooms/$(rid)/files/$(fid)).data.uid; }
          function canRemove(owner) { return isMember(cid) && (owner == uid()
            || (rid == 'main' && isLeader(cid))
            || (room().type != 'main' && admin(room()))); }

          allow read: if inRoom();
          allow create: if inRoom()
            && request.resource.data.keys().hasOnly(['uid', 'n', 'size', 'createdAt'])
            && request.resource.data.uid == uid()
            && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 20
            && request.resource.data.size is int && request.resource.data.size <= 11 * 1024 * 1024
            && request.resource.data.createdAt == request.time;
          allow delete: if canRemove(resource.data.uid);

          match /parts/{p} {
            allow read: if inRoom();
            allow create: if inRoom() && fileOwner() == uid()
              && request.resource.data.keys().hasOnly(['d'])
              && request.resource.data.d is string && request.resource.data.d.size() <= 850000;
            allow delete: if canRemove(fileOwner());
          }
        }
      }
    }
  }
}
